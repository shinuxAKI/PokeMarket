@model PokeMarketApi.Models.ApiRequestViewModel
@{
    ViewData["Title"] = "API Request";
}
<section class="api-request-page">
    <div class="eyebrow">POKÉMARKET DEVELOPERS</div>
    <h1>API Access Request</h1>
    <p>Tell us a little about your project. After submitting, your personal API endpoint and key will be generated.</p>

    @if (Model.Submitted && !string.IsNullOrWhiteSpace(Model.ApiKey))
    {
        <div class="api-result">
            <div class="api-result-icon">✓</div>
            <h2>Your API credentials are ready!</h2>
            <p>Keep your API key private. It is shown only once and cannot be recovered later.</p>
            <label>API URL</label>
            <div class="credential-row">
                <code id="apiUrl">@Model.ApiUrl</code>
                <button type="button" class="copy-button" onclick="copyCredential('apiUrl', this)">Copy</button>
            </div>
            <label>API Key</label>
            <div class="credential-row">
                <code id="apiKey">@Model.ApiKey</code>
                <button type="button" class="copy-button" onclick="copyCredential('apiKey', this)">Copy</button>
            </div>
            <div class="api-warning">Your key is stored securely as a hash. Copy it now and save it somewhere safe.</div>
            <h3>How to use it</h3>
            <p>Send a GET request to the API URL and include this HTTP header:</p>
            <pre><code>X-API-Key: YOUR_API_KEY</code></pre>
            <a class="btn" href="/ApiRequest">Generate another key</a>
        </div>
    }
    else
    {
        <form asp-action="Index" method="post" class="api-request-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <label asp-for="ApplicationName"></label>
            <input asp-for="ApplicationName" placeholder="e.g. My Pokémon Collection App" />
            <span asp-validation-for="ApplicationName" class="text-danger"></span>

            <label asp-for="ContactEmail"></label>
            <input asp-for="ContactEmail" placeholder="you@example.com" />
            <span asp-validation-for="ContactEmail" class="text-danger"></span>

            <label asp-for="Website"></label>
            <input asp-for="Website" placeholder="https://example.com" />
            <span asp-validation-for="Website" class="text-danger"></span>

            <label asp-for="Purpose"></label>
            <textarea asp-for="Purpose" rows="5" placeholder="Describe what you're building and how you'll use the PokéMarket card catalogue..."></textarea>
            <span asp-validation-for="Purpose" class="text-danger"></span>

            <button type="submit">Submit API Request →</button>
        </form>
    }
</section>
@section Scripts {
<script>
async function copyCredential(id, button) {
    const value = document.getElementById(id).textContent.trim();
    try {
        await navigator.clipboard.writeText(value);
        const previous = button.textContent;
        button.textContent = 'Copied!';
        setTimeout(() => button.textContent = previous, 1400);
    } catch {
        alert('Copy failed. Please select and copy the value manually.');
    }
}
</script>
}
