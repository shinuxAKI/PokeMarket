@model PokeMarketApi.Models.ApiRequestPageViewModel
@{
    ViewData["Title"] = "API Request";
}
<section class="api-request-page">
    <div class="eyebrow">POKÉMARKET DEVELOPERS</div>
    <h1>API Access</h1>
    <p>Submit a request for access to the PokéMarket card catalogue API. An administrator reviews each request before issuing a key.</p>

    @if (TempData["ApiRequestMessage"] is string message)
    {
        <div class="api-notice">@message</div>
    }

    <h2>Your requests</h2>
    @if (Model.Requests.Count == 0)
    {
        <p>You have not submitted an API access request yet.</p>
    }
    @foreach (var request in Model.Requests)
    {
        <article class="api-user-request">
            <div class="api-admin-heading">
                <div><h3>@request.ApplicationName</h3><small>Submitted @request.CreatedAt.ToLocalTime().ToString("g")</small></div>
                <span class="api-status status-@request.Status.ToLowerInvariant()">@request.Status</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(request.AdminNotes))
            {
                <p><strong>Administrator note:</strong> @request.AdminNotes</p>
            }
            @if (request.Status == "Pending")
            {
                <p>Your request is waiting for administrator approval. No API key has been issued yet.</p>
            }
            else if (request.Status == "Rejected")
            {
                <p>This request was not approved. You can submit a new request below if your project details have changed.</p>
            }
            else if (request.Status == "Revoked")
            {
                <p>This API key has been revoked and can no longer be used.</p>
            }
            else if (request.Status == "Approved")
            {
                <p>Your API access is approved.</p>
                <label>API URL</label>
                <div class="credential-row">
                    <code id="apiUrl-@request.Id">@Model.ApiUrl</code>
                    <button type="button" class="copy-button" onclick="copyCredential('apiUrl-@request.Id', this)">Copy</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(request.ApiKey))
                {
                    <label>API Key</label>
                    <div class="credential-row">
                        <code id="apiKey-@request.Id">@request.ApiKey</code>
                        <button type="button" class="copy-button" onclick="copyCredential('apiKey-@request.Id', this)">Copy</button>
                    </div>
                }
                else
                {
                    <div class="api-warning">This key was issued by an older version and cannot be displayed. Rotate it to create a new key you can manage here.</div>
                }
                <p>Include the following header in your GET request:</p>
                <pre><code>X-API-Key: YOUR_API_KEY</code></pre>
                <div class="api-admin-actions">
                    <form asp-action="Rotate" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@request.Id" />
                        <button type="submit">Rotate API key</button>
                    </form>
                    <form asp-action="Revoke" method="post" onsubmit="return confirm('Revoke this API key? Applications using it will stop working.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@request.Id" />
                        <button type="submit" class="api-danger-button">Revoke access</button>
                    </form>
                </div>
            }
        </article>
    }

    <div class="api-request-divider"></div>
    <h2>Request API access</h2>
    <form asp-action="Index" method="post" class="api-request-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label asp-for="Form.ApplicationName"></label>
        <input asp-for="Form.ApplicationName" placeholder="e.g. My Pokémon Collection App" />
        <span asp-validation-for="Form.ApplicationName" class="text-danger"></span>

        <label asp-for="Form.ContactEmail"></label>
        <input asp-for="Form.ContactEmail" placeholder="you@example.com" />
        <span asp-validation-for="Form.ContactEmail" class="text-danger"></span>

        <label asp-for="Form.Website"></label>
        <input asp-for="Form.Website" placeholder="https://example.com" />
        <span asp-validation-for="Form.Website" class="text-danger"></span>

        <label asp-for="Form.Purpose"></label>
        <textarea asp-for="Form.Purpose" rows="5" placeholder="Describe what you're building and how you'll use the PokéMarket card catalogue..."></textarea>
        <span asp-validation-for="Form.Purpose" class="text-danger"></span>

        <button type="submit">Submit API Request →</button>
    </form>
</section>
@section Scripts {
<script>
async function copyCredential(id, button) {
    const value = document.getElementById(id).textContent.trim();
    try {
        await navigator.clipboard.writeText(value);
        const previous = button.textContent;
        button.textContent = 'Copied!';
        setTimeout(() => button.textContent = previous, 1400);
    } catch {
        alert('Copy failed. Please select and copy the value manually.');
    }
}
</script>
}
