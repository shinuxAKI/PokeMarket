@model IEnumerable<PokeMarketApi.Models.FavouriteItem>
@{ ViewData["Title"] = "Favourites"; var items = Model.ToList(); }
<p class="eyebrow">SAVED FOR LATER</p>
<h1>Your favourites</h1>
@if (TempData["FavouriteMessage"] is string message) { <p class="notice" role="status">@message</p> }
<p class="muted">@items.Count saved product(s)</p>
<div class="grid">
@foreach (var item in items)
{
    <article class="product">
        <a href="/Products/Details/@item.CatalogCardId"><img src="@(item.ImageUrl ?? "https://placehold.co/240x330")" alt="@item.ProductName"><b>@item.ProductName</b></a>
        <small>@item.SetName</small>
        <strong data-qar="@item.PriceQar">QAR @item.PriceQar.ToString("N2")</strong>
        <a class="linkbtn" href="/Products/Details/@item.CatalogCardId">View product</a>
        <form method="post" action="/Favourites/Toggle">
            @Html.AntiForgeryToken()
            <input type="hidden" name="catalogCardId" value="@item.CatalogCardId">
            <input type="hidden" name="returnUrl" value="/Favourites">
            <button class="linkbtn" type="submit">Remove favourite</button>
        </form>
    </article>
}
</div>
@if (!items.Any()) { <p class="notice">No favourites saved yet. <a href="/Search">Browse the catalogue</a> and save products you like.</p> }