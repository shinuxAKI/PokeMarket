@model IEnumerable<CatalogCard>
@{ViewData["Title"]="Home";}<section class="hero"><p class="eyebrow">COLLECT · TRADE · DISCOVER</p><h1>Your next favourite card is here.</h1><p>Explore Pokémon cards and track your collection.</p><a class="btn" href="/Search">Explore catalogue</a></section>@if(ViewBag.Offline==true){<p class="notice">Catalogue offline. Start PokemonMvc and check CatalogApi:BaseUrl in appsettings.json.</p>}<div class="sectionhead"><h2>Featured cards</h2><a href="/Search">View all →</a></div><div class="grid">@foreach(var c in Model){<a class="product" href="/Products/Details/@c.Id"><img src="@(c.ImageUrl??"https://placehold.co/240x330")"><b>@c.Name</b><small>@c.SetName · @c.Rarity</small><strong>QAR @c.MarketPriceQar</strong></a>}</div><section class="twocol"><div><h2>Build your collection</h2><p>Track owned and graded cards.</p><a href="/Portfolio">Portfolio →</a></div><div><h2>Sell your cards</h2><p>Publish a demo seller listing.</p><a href="/Sell">Seller area →</a></div></section>