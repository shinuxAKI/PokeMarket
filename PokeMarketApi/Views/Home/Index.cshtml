@model IEnumerable<CatalogCard>
@{ ViewData["Title"] = "Home"; }
<section class="hero">
    <p class="eyebrow">COLLECT · TRADE · DISCOVER</p>
    <h1>Your next favourite card is here.</h1>
    <p>Explore Pokémon cards, shop the catalogue and track your collection.</p>
    <a class="btn" href="/Shop">Visit the shop</a>
    <a href="/Search">Search the catalogue →</a>
</section>
@if (ViewBag.Offline == true) { <p class="notice"><strong>Catalogue offline.</strong> Start PokemonMvc and check that its API is available at http://localhost:5165/api/catalog/cards.</p> }
<div class="sectionhead"><div><p class="eyebrow">DISCOVER</p><h2>Featured cards</h2></div><a href="/Shop">Shop all →</a></div>
<div class="grid">
@foreach (var card in Model.Take(8))
{
    <a class="product" href="/Products/Details/@card.Id">
        <img src="@(card.ImageUrl ?? "https://placehold.co/240x330?text=Pok%C3%A9mon")" alt="@card.Name">
        <b>@card.Name</b><small>@card.SetName · @card.Rarity</small>
        <strong data-qar="@card.MarketPriceQar">QAR @card.MarketPriceQar.ToString("N2")</strong>
    </a>
}
</div>
<section class="twocol">
    <div><h2>Build your collection</h2><p>Track owned and graded cards in your personal portfolio.</p><a href="/Portfolio">Open portfolio →</a></div>
    <div><h2>Meet other collectors</h2><p>Connect with registered members and send private messages.</p><a href="/Social">Visit community →</a></div>
</section>