@model IEnumerable<CatalogCard>
@{
    ViewData["Title"] = "Home";
}
<section class="hero">
    <p class="eyebrow">COLLECT · TRADE · DISCOVER</p>
    <h1>Your next favourite card is here.</h1>
    <p>Explore Pokémon cards, shop the catalogue and track your collection.</p>
    <a class="btn" href="/Shop">Visit the shop</a>
    <a href="/Search">Search the catalogue →</a>
</section>
@if (ViewBag.Offline == true)
{
    <p class="notice">Catalogue offline. Start PokemonMvc and check CatalogApi:BaseUrl in appsettings.json.</p>
}
<div class="sectionhead">
    <h2>Featured cards</h2>
    <a href="/Shop">Shop all →</a>
</div>
<div class="grid">
    @foreach (var card in Model)
    {
        <a class="product" href="/Products/Details/@card.Id">
            <img src="@(card.ImageUrl ?? "https://placehold.co/240x330")" alt="@card.Name">
            <b>@card.Name</b>
            <small>@card.SetName · @card.Rarity</small>
            <strong>QAR @card.MarketPriceQar</strong>
        </a>
    }
</div>
<section class="twocol">
    <div>
        <h2>Build your collection</h2>
        <p>Track owned and graded cards.</p>
        <a href="/Portfolio">Portfolio →</a>
    </div>
    <div>
        <h2>Sell your cards</h2>
        <p>Publish and manage a demo seller listing.</p>
        <a href="/Sell">Seller area →</a>
    </div>
</section>
