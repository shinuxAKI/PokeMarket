@model IEnumerable<PortfolioItem>
@{
    ViewData["Title"] = "Portfolio";
    var items = Model.ToList();
    var totalValue = items.Sum(x => x.CurrentValueQar * x.Quantity);
    var totalCopies = items.Sum(x => x.Quantity);
}
<p class="eyebrow">YOUR COLLECTION</p>
<h1>Your portfolio</h1>
@if (TempData["PortfolioMessage"] is string message)
{
    <p class="notice" role="status">@message</p>
}
<div class="stats">
    <div><small>Estimated collection value</small><h2 data-qar="@totalValue">QAR @totalValue.ToString("N2")</h2></div>
    <div><small>Unique entries</small><h2>@items.Count</h2></div>
    <div><small>Total copies</small><h2>@totalCopies</h2></div>
</div>
<p class="muted">Values are based on the catalogue price at the time you added or last updated an item. They are estimates, not verified sale prices.</p>
<div class="grid">
@foreach (var x in items)
{
    var itemTotal = x.CurrentValueQar * x.Quantity;
    <article class="product">
        <img src="@(x.ImageUrl ?? "https://placehold.co/240x330?text=Pok%C3%A9mon")" alt="@x.ProductName">
        <b>@x.ProductName</b>
        <small>@x.SetName · @x.Grade</small>
        <small>@x.Condition · Quantity: @x.Quantity</small>
        <small>Unit value: <span data-qar="@x.CurrentValueQar">QAR @x.CurrentValueQar.ToString("N2")</span></small>
        <strong data-qar="@itemTotal">QAR @itemTotal.ToString("N2") total</strong>
        <form method="post" action="/Portfolio/Update" class="collection-edit">
            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id">
            <label>Quantity <input type="number" name="quantity" min="1" max="999" value="@x.Quantity" required></label>
            <label>Condition <select name="condition"><option selected="@(x.Condition == "Near Mint")">Near Mint</option><option selected="@(x.Condition == "Lightly Played")">Lightly Played</option><option selected="@(x.Condition == "Moderately Played")">Moderately Played</option><option selected="@(x.Condition == "Heavily Played")">Heavily Played</option><option selected="@(x.Condition == "Damaged")">Damaged</option></select></label>
            <label>Grade <select name="grade"><option selected="@(x.Grade == "Ungraded")">Ungraded</option>@for (int i=1;i<=10;i++) { <option selected="@(x.Grade == "PSA " + i)">PSA @i</option> }</select></label>
            <button class="btn">Save changes</button>
        </form>
        <form method="post" action="/Portfolio/Remove" onsubmit="return confirm('Remove this item from your collection?')">
            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"><button class="linkbtn">Remove</button>
        </form>
    </article>
}
</div>
@if (!items.Any()) { <p class="notice">Your portfolio is empty. Open the <a href="/Shop">Shop</a> or <a href="/Search">search the catalogue</a> and add your first card.</p> }