@model CatalogCard
@{
    ViewData["Title"] = Model.Name;
    var reviews = ViewBag.Reviews as IEnumerable<ProductReview> ?? Enumerable.Empty<ProductReview>();
    var history = ViewBag.PriceHistory as IEnumerable<PriceSnapshot> ?? Enumerable.Empty<PriceSnapshot>();
    double? average = ViewBag.AverageRating as double?;
    var maxPrice = Math.Max(1m, history.Any() ? history.Max(x => x.PriceQar) : 1m);
}
<div class="detail">
    <img src="@(Model.ImageUrl ?? "https://placehold.co/300x420?text=Pok%C3%A9mon")" alt="@Model.Name">
    <div>
        <p class="eyebrow">@Model.SetName</p><h1>@Model.Name</h1>
        <p>@Model.CardNumber · @Model.Rarity · @Model.Language</p>
        <h2 data-qar="@Model.MarketPriceQar">QAR @Model.MarketPriceQar.ToString("N2")</h2>
        <p>@(average.HasValue ? "★ " + average.Value.ToString("0.0") + " / 5" : "No reviews yet") · @reviews.Count() reviews</p>
        <form method="post" action="/Favourites/Toggle">
            @Html.AntiForgeryToken()
            <input type="hidden" name="catalogCardId" value="@Model.Id"><input type="hidden" name="productName" value="@Model.Name">
            <input type="hidden" name="imageUrl" value="@Model.ImageUrl"><input type="hidden" name="setName" value="@Model.SetName">
            <input type="hidden" name="priceQar" value="@Model.MarketPriceQar">
            @if (User.Identity?.IsAuthenticated == true) { <button class="btn" type="submit">@(ViewBag.IsFavourite == true ? "Remove from wishlist" : "♡ Add to wishlist")</button> }
            else { <a class="btn" href="/Identity/Account/Login">Sign in to save</a> }
        </form>
        <form method="post" action="/Portfolio/Add">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productName" value="@Model.Name"><input type="hidden" name="imageUrl" value="@Model.ImageUrl">
            <input type="hidden" name="setName" value="@Model.SetName"><input type="hidden" name="currentValueQar" value="@Model.MarketPriceQar">
            <label>Quantity <input type="number" name="quantity" min="1" max="999" value="1"></label>
            <label>Condition <select name="condition"><option>Near Mint</option><option>Lightly Played</option><option>Moderately Played</option><option>Heavily Played</option><option>Damaged</option></select></label>
            <select name="grade"><option>Ungraded</option>@for (int i=1;i<=10;i++) { <option>PSA @i</option> }</select>
            @if (User.Identity?.IsAuthenticated == true) { <button class="btn">Add to collection</button> }
            else { <a class="btn" href="/Identity/Account/Login">Sign in to collect</a> }
        </form>
    </div>
</div>
<section class="price-history">
    <div class="sectionhead"><div><p class="eyebrow">PRICE TRACKER</p><h2>Price history</h2></div></div>
    <p class="notice">Illustrative demo history based on the catalogue price. These are not verified market transactions or live price data.</p>
    <div class="history-chart">
    @foreach (var point in history)
    {
        <div class="history-bar-column">
            <strong>QAR @point.PriceQar.ToString("N0")</strong>
            <div class="history-bar-track"><div class="history-bar" style="height:@((double)(point.PriceQar / maxPrice * 100m))%"></div></div>
            <small>@point.RecordedAt.ToLocalTime().ToString("dd MMM")</small>
        </div>
    }
    </div>
</section>
<section id="reviews" class="reviews-section">
    <div class="sectionhead"><div><p class="eyebrow">COLLECTOR FEEDBACK</p><h2>Reviews</h2></div></div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form method="post" action="/Reviews/Add" class="review-form">
            @Html.AntiForgeryToken()<input type="hidden" name="catalogCardId" value="@Model.Id">
            <label>Your rating <select name="rating"><option value="5">5 stars</option><option value="4">4 stars</option><option value="3">3 stars</option><option value="2">2 stars</option><option value="1">1 star</option></select></label>
            <label>Your review <textarea name="comment" maxlength="800" rows="3" placeholder="Share your thoughts about this product..."></textarea></label>
            <button class="btn">Post / update review</button>
        </form>
    }
    else { <p class="notice"><a href="/Identity/Account/Login">Sign in</a> to leave a review.</p> }
    @foreach (var review in reviews)
    {
        <article class="review-card"><strong>PokéMarket collector</strong><span class="review-stars">@(new string('★', review.Rating) + new string('☆', 5-review.Rating))</span><p>@review.Comment</p><small>@review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small></article>
    }
    @if (!reviews.Any()) { <p class="muted">No reviews yet. Be the first to review this product.</p> }
</section>