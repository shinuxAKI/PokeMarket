@{ ViewData["Title"] = "Profile"; }
<section class="hero">
    <p class="eyebrow">YOUR ACCOUNT</p><h1>Welcome back.</h1><p>@ViewBag.Email</p>
    <a class="btn" href="/Identity/Account/Manage">Manage account</a>
</section>
<div class="stats">
    <div><small>Unique collection items</small><h2>@ViewBag.Items</h2></div>
    <div><small>Total cards owned</small><h2>@ViewBag.TotalCards</h2></div>
    <div><small>Collection value (demo prices)</small><h2>QAR @(((decimal)ViewBag.Value).ToString("N2"))</h2></div>
</div>
<div class="stats">
    <div><small>Seller listings</small><h2>@ViewBag.Listings</h2></div>
    <div><small>Wishlist items</small><h2>@ViewBag.Favourites</h2></div>
    <div><small>Account</small><h2>Active</h2></div>
</div>
<div class="twocol">
    <div><h2>Account settings</h2><p>Change your password and manage your account details.</p><a href="/Identity/Account/Manage">Open settings →</a></div>
    <div><h2>Your collector tools</h2><p><a href="/Portfolio">Open collection →</a></p><p><a href="/Favourites">Open wishlist →</a></p><p><a href="/Sell">Manage seller listings →</a></p><p><a href="/Social">Community messages →</a></p></div>
</div>