@model IEnumerable<CatalogCard>
@{ViewData["Title"]="Search";}<h1>Discover Pokémon</h1><form class="filters" method="get"><input name="q" placeholder="Search card name or number"><select name="setName"><option value="">All sets</option>@foreach(string s in ViewBag.Sets){<option value="@s">@s</option>}</select><select name="language"><option value="">All languages</option><option>English</option><option>Japanese</option></select><button class="btn">Filter</button></form><div class="grid">@foreach(var c in Model){<a class="product" href="/Products/Details/@c.Id"><img src="@(c.ImageUrl??"https://placehold.co/240x330")"><b>@c.Name</b><small>@c.CardNumber · @c.SetName</small><strong>QAR @c.MarketPriceQar</strong></a>}</div>