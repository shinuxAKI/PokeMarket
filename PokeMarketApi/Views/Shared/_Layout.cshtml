<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#ffffff">
    <title>@ViewData["Title"] · PokéMarket</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
<header>
    <a class="logo" href="/">◉ PokéMarket</a>
    <form action="/Search" method="get" class="topsearch">
        <input name="q" placeholder="Search cards and sets" aria-label="Search cards and sets">
        <button type="submit">Search</button>
    </form>
    <select id="currency" aria-label="Display currency" onchange="document.cookie='currency='+this.value+';path=/;samesite=lax';location.reload()">
        <option>QAR</option><option>USD</option><option>EUR</option><option>GBP</option><option>PHP</option><option>JPY</option>
    </select>
    <a href="/Identity/Account/Login">Account</a>
</header>
<main>@RenderBody()</main>
<nav class="bottom" aria-label="Main navigation">
    <a href="/">⌂<small>Home</small></a>
    <a href="/Search">⌕<small>Search</small></a>
    <a href="/Shop">▣<small>Shop</small></a>
    <a href="/Social">♡<small>Social</small></a>
    <a href="/Portfolio">▤<small>Portfolio</small></a>
    <a href="/Identity/Account/Manage">◎<small>Profile</small></a>
</nav>
<script>
    const currency = document.getElementById('currency');
    const selected = document.cookie.split('; ').find(x => x.startsWith('currency='))?.split('=')[1] || 'QAR';
    currency.value = selected;
</script>
</body>
</html>