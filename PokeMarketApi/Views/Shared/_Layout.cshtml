<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] · PokéMarket</title><link rel="stylesheet" href="~/css/site.css"></head><body><header><a class="logo" href="/">◉ PokéMarket</a><form action="/Search" class="topsearch"><input name="q" placeholder="Search cards and sets"><button>Search</button></form><select id="currency" onchange="document.cookie='currency='+this.value+';path=/';location.reload()"><option>QAR</option><option>USD</option><option>EUR</option><option>GBP</option><option>PHP</option><option>JPY</option></select><a href="/Identity/Account/Login">Login</a></header><main>@RenderBody()</main><nav class="bottom"><a href="/">⌂<small>Home</small></a><a href="/Search">⌕<small>Search</small></a><a href="/Sell">▣<small>Shop</small></a><a href="/Social">♡<small>Social</small></a><a href="/Portfolio">▤<small>Portfolio</small></a><a href="/Identity/Account/Manage">◎<small>Profile</small></a></nav><script>const c=document.cookie.split('; ').find(x=>x.startsWith('currency='))?.split('=')[1]||'QAR';document.getElementById('currency').value=c;</script></body></html>