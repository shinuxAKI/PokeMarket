<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#ffffff">
    <title>@ViewData["Title"] · PokéMarket</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
<header>
    <a class="logo" href="/">◉ PokéMarket</a>
    <select id="currency" aria-label="Display currency" onchange="changeCurrency(this.value)">
        <option value="QAR">QAR</option><option value="USD">USD</option><option value="EUR">EUR</option><option value="GBP">GBP</option><option value="PHP">PHP</option><option value="JPY">JPY</option>
    </select>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a href="/Profile">My profile</a>
    }
    else
    {
        <a href="/Identity/Account/Login">Sign in</a>
    }
</header>
<main>@RenderBody()</main>
<nav class="bottom" aria-label="Main navigation">
    <a href="/">⌂<small>Home</small></a>
    <a href="/Search">⌕<small>Search</small></a>
    <a href="/Shop">▣<small>Shop</small></a>
    <a href="/Social">♡<small>Social</small></a>
    <a href="/Portfolio">▤<small>Portfolio</small></a>
    <a href="/Profile">◎<small>Profile</small></a>
</nav>
<script>
async function changeCurrency(code) {
    document.cookie = 'currency=' + code + ';path=/;samesite=lax';
    const labels = document.querySelectorAll('[data-qar]');
    if (code === 'QAR') { labels.forEach(el => el.textContent = 'QAR ' + Number(el.dataset.qar).toFixed(2)); return; }
    try {
        const response = await fetch('https://open.er-api.com/v6/latest/QAR');
        if (!response.ok) throw new Error('Rate service unavailable');
        const data = await response.json();
        const rate = data.rates?.[code];
        if (!rate) throw new Error('Currency unavailable');
        labels.forEach(el => el.textContent = code + ' ' + (Number(el.dataset.qar) * rate).toFixed(2));
    } catch {
        alert('Live conversion is unavailable right now. Prices remain in QAR.');
        document.getElementById('currency').value = 'QAR';
        document.cookie = 'currency=QAR;path=/;samesite=lax';
    }
}
document.addEventListener('DOMContentLoaded', () => {
    const selected = document.cookie.split('; ').find(x => x.startsWith('currency='))?.split('=')[1] || 'QAR';
    const selector = document.getElementById('currency');
    selector.value = selected;
    if (selected !== 'QAR') changeCurrency(selected);
});
</script>
</body>
</html>