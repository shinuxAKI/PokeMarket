@model IEnumerable<CatalogCard>
@{
    ViewData["Title"] = "Shop";
}
<section class="sectionhead">
    <div>
        <p class="eyebrow">POKÉMARKET STORE</p>
        <h1>Shop Pokémon cards</h1>
        <p>Browse products from the PokéMarket catalogue.</p>
    </div>
    <a href="/Search">Advanced search →</a>
</section>
@if (ViewBag.Offline == true)
{
    <p class="notice">The catalogue is offline. Start PokemonMvc and check CatalogApi:BaseUrl in appsettings.json.</p>
}
@if (!Model.Any() && ViewBag.Offline != true)
{
    <p class="notice">No catalogue products have been added yet.</p>
}
<div class="grid">
    @foreach (var item in Model)
    {
        <a class="product" href="/Products/Details/@item.Id">
            <img src="@(item.ImageUrl ?? "https://placehold.co/240x330")" alt="@item.Name">
            <b>@item.Name</b>
            <small>@item.SetName · @item.Rarity</small>
            <strong>QAR @item.MarketPriceQar</strong>
        </a>
    }
</div>
<p class="muted">This is the store catalogue. Community seller listings are separate and available in the seller area.</p>
