@model IEnumerable<Card>
@{ViewData["Title"]="Cards";}<h1>Pokémon cards</h1><a class="btn" href="/Cards/Create">＋ Add card</a><form method="get"><input name="search" placeholder="Search name or card number"><button>Search</button></form><div class="grid">@foreach(var c in Model){<article class="card"><a href="/Cards/Details/@c.Id"><img src="@(c.ImageUrl??"https://placehold.co/240x330")"><b>@c.Name</b></a><small>@c.ProductType · @c.CardNumber · @c.SetName · @c.Rarity</small><strong>QAR @c.MarketPriceQar</strong><a href="/Cards/Edit/@c.Id">Edit</a> <a href="/Cards/Delete/@c.Id">Delete</a></article>}</div>