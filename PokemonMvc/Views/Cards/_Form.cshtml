@model Card
<div class="formgrid">
    <label>Product name<input asp-for="Name" placeholder="e.g. Charizard ex"></label>
    <label>Card ID / number<input asp-for="CardNumber" placeholder="e.g. 223/197"></label>
    <label>Set / pack to obtain<input asp-for="SetName" placeholder="e.g. Obsidian Flames"></label>
    <label>Language<select asp-for="Language"><option>English</option><option>Japanese</option></select></label>
    <label>Product type<select asp-for="ProductType"><option>Card</option><option>Booster Pack</option><option>Trainer Box</option></select></label>
    <label>Rarity<select asp-for="Rarity"><option>Common</option><option>Rare</option><option>Super Rare</option><option>Ultra Rare</option><option>Illustration Rare</option><option>Special Illustration Rare</option></select></label>
    <label>Market price QAR<input asp-for="MarketPriceQar" type="number" min="0" step="0.01"></label>
    <label>Photo URL<input asp-for="ImageUrl" type="text" placeholder="https://example.com/product-image.jpg"></label>
</div>
<p class="muted">Paste a direct link to the product image (JPG, PNG or WEBP). The image will appear in the catalogue and marketplace.</p>
