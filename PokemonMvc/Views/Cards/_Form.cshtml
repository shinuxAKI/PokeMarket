@model Card
<div class="formgrid"><label>Card name<input asp-for="Name"></label><label>Card ID / number<input asp-for="CardNumber"></label><label>Set / pack to obtain<input asp-for="SetName"></label><label>Language<select asp-for="Language"><option>English</option><option>Japanese</option></select></label><label>Product type<select asp-for="ProductType"><option>Card</option><option>Booster Pack</option><option>Trainer Box</option></select></label><label>Rarity<select asp-for="Rarity"><option>Common</option><option>Rare</option><option>Super Rare</option><option>Ultra Rare</option><option>Illustration Rare</option><option>Special Illustration Rare</option></select></label><label>Market price QAR<input asp-for="MarketPriceQar" type="number" step="0.01"></label><label>Photo upload<input type="file" name="photo" accept="image/*"></label><label>Image URL<input asp-for="ImageUrl"></label></div>