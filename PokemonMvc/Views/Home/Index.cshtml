@model IEnumerable<Card>
@{ ViewData["Title"] = "Dashboard"; }
<section class="hero">
    <h1>Pokémon catalogue</h1>
    <p>Manage your Pokémon cards, booster packs and Trainer Boxes.</p>
    <a class="btn" href="/Cards">Manage catalogue</a>
    <a class="btn" href="/Cards/Create">＋ Add product</a>
</section>
<h2>Featured products</h2>
<div class="grid">
@foreach (var c in Model)
{
    <a class="card" href="/Cards/Details/@c.Id">
        <img src="@(string.IsNullOrWhiteSpace(c.ImageUrl) ? "https://placehold.co/240x330?text=Pok%C3%A9Market" : c.ImageUrl)" alt="@c.Name" loading="lazy">
        <b>@c.Name</b>
        <small>@c.ProductType · @c.SetName · @c.Rarity</small>
        <strong>QAR @c.MarketPriceQar</strong>
    </a>
}
</div>