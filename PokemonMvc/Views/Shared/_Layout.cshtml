<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>@ViewData["Title"] · PokéMarket Catalogue</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
<header>
    <a href="/">PokéMarket · CATALOGUE</a>
    <nav>
        @if (User.IsInRole("Admin"))
        {
            <a href="/Admin">Dashboard</a>
            <a href="/Cards">Manage catalogue</a>
            <a href="/Cards/Create">＋ Add product</a>
        }
        <partial name="_LoginPartial" />
    </nav>
</header>
<main>@RenderBody()</main>
<script>
document.querySelectorAll('form.catalogue-filters').forEach(form => form.addEventListener('submit', () => {
    const button = form.querySelector('button[type=submit], button:not([type])');
    if (button) { button.disabled = true; button.textContent = 'Loading...'; }
}));
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
